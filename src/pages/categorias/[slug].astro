---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { categories, textoAlternativo, nombreCompleto } from '../../data/categories.ts';
import type { Category } from '../../data/categories.ts';

const SITE_URL = "https://www.distribuidorasingluten.com.ar";

/** Cuántas imágenes se cargan de forma prioritaria (las que entran en pantalla). */
const EAGER_IMAGES = 4;

type Contenido = {
  intro: string;
  secciones: { titulo: string; cuerpo: string }[];
  marcas: string[] | null;
  presentaciones: string | null;
  minimoCompra: string | null;
  relacionadas: string[];
};

export async function getStaticPaths() {
  const entradas = await getCollection('categorias');
  const porSlug = new Map(entradas.map(e => [e.id, e.data]));

  return categories.map(cat => ({
    params: { slug: cat.slug },
    props: { cat, contenido: porSlug.get(cat.slug) ?? null },
  }));
}

interface Props { cat: Category; contenido: Contenido | null }
const { cat, contenido } = Astro.props;

/** Párrafos separados por línea en blanco. */
const parrafos = (texto: string) =>
  texto.split(/\n\s*\n/).map(p => p.trim().replace(/\s*\n\s*/g, ' ')).filter(Boolean);

/**
 * Marcas de la categoría, derivadas del catálogo. Cada una está visible en las
 * cards de más abajo, así que la lista no afirma nada que no esté en la página.
 * El YAML puede sobrescribirla si el cliente prefiere un orden o recorte propio.
 */
const marcas = contenido?.marcas
  ?? [...new Set(cat.productos.map(p => p.marca).filter(Boolean))]
      .sort((a, b) => a!.localeCompare(b!, 'es')) as string[];

/** Categorías relacionadas para el enlazado cruzado (T3). */
const relacionadas = (contenido?.relacionadas ?? [])
  .map(slug => categories.find(c => c.slug === slug))
  .filter((c): c is Category => Boolean(c));

/** El resto del catálogo, para que ninguna categoría quede sin salida. */
const restoDelCatalogo = categories.filter(
  c => c.slug !== cat.slug && !relacionadas.some(r => r.slug === c.slug)
);

const title = `${cat.name} Sin Gluten al Por Mayor | Distribuidora Mayorista Cuyo`;
const description = `Distribuidora mayorista de ${cat.name.toLowerCase()} sin gluten en Mendoza, San Juan y San Luis. ${cat.count} productos certificados por ANMAT. Solo venta a comercios.`;
const image = cat.productos[0]?.imagen ?? cat.imageUrl;

const whatsappHref = `https://wa.me/5492615080439?text=Hola%2C%20quiero%20consultar%20precios%20mayoristas%20de%20${encodeURIComponent(cat.name)}%20sin%20gluten.`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE_URL },
        { "@type": "ListItem", "position": 2, "name": "Catálogo", "item": `${SITE_URL}/#categorias` },
        { "@type": "ListItem", "position": 3, "name": cat.name }
      ]
    },
    {
      // Sólo se afirma lo que está visible en el HTML: nombre, marca y
      // presentación salen de la misma etiqueta que se renderiza en la card.
      // Sin `offers`: los precios son mayoristas y no son públicos.
      "@type": "ItemList",
      "@id": `${SITE_URL}/categorias/${cat.slug}/#list`,
      "name": `${cat.name} sin gluten`,
      "description": `Distribuidora mayorista de ${cat.name.toLowerCase()} sin gluten en Cuyo. ${cat.count} productos certificados por ANMAT.`,
      "numberOfItems": cat.count,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "itemListElement": cat.productos.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "Product",
          "@id": `${SITE_URL}/categorias/${cat.slug}/#producto-${p.id}`,
          "name": nombreCompleto(p),
          "image": p.imagen,
          "category": `${cat.name} sin gluten`,
          ...(p.marca ? { "brand": { "@type": "Brand", "name": p.marca } } : {}),
        }
      }))
    }
  ]
};
---

<Layout title={title} description={description} image={image}>
  <Header />

  <main class="pt-16 lg:pt-20">
    <!-- Breadcrumb -->
    <div class="bg-[#FAFAF8] border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-sm text-gray-500">
          <a href="/" class="hover:text-[#2D6A4F] transition-colors">Inicio</a>
          <span>›</span>
          <a href="/#categorias" class="hover:text-[#2D6A4F] transition-colors">Catálogo</a>
          <span>›</span>
          <span class="text-[#1C1C1C] font-medium">{cat.name}</span>
        </nav>
      </div>
    </div>

    <!-- Hero de categoría -->
    <section class="py-16 lg:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <span class="inline-block text-[#2D6A4F] text-sm font-semibold tracking-widest uppercase mb-4">
            Distribución mayorista
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-[#1C1C1C] leading-tight mb-4">
            {cat.name}<br/>
            <span class="text-[#2D6A4F]">sin gluten al por mayor</span>
          </h1>
          <p class="text-lg text-gray-600 mb-3">
            <strong class="text-[#1C1C1C]">{cat.count} productos certificados por ANMAT</strong> · Distribución directa en Mendoza, San Juan y San Luis.
          </p>
          <p class="text-base text-gray-500 mb-8">
            Todos nuestros {cat.name.toLowerCase()} sin gluten cuentan con certificación oficial de ANMAT (Administración Nacional de Medicamentos, Alimentos y Tecnología Médica) y son aptos para celíacos y personas con intolerancia al gluten.
          </p>

          <!-- Badges -->
          <div class="flex flex-wrap gap-3 mb-8">
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#2D6A4F] bg-[#2D6A4F]/10 px-4 py-2 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2D6A4F]"></span>
              {cat.count} productos disponibles
            </span>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#2D6A4F] bg-[#2D6A4F]/10 px-4 py-2 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2D6A4F]"></span>
              Certificado ANMAT
            </span>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-[#2D6A4F] bg-[#2D6A4F]/10 px-4 py-2 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2D6A4F]"></span>
              Solo mayorista
            </span>
          </div>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#1da851] text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 shadow-md text-base"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
              <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/>
            </svg>
            Consultar precios de {cat.name}
          </a>
        </div>
      </div>
    </section>

    <!-- Imágenes de productos -->
    {cat.productos.length > 0 && (
      <section class="py-12 bg-[#FAFAF8]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-xl font-semibold text-[#1C1C1C] mb-6">
            {cat.count} {cat.name.toLowerCase()} sin gluten en nuestro catálogo
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            {cat.productos.map((p, i) => (
              <figure
                id={`producto-${p.id}`}
                class="flex flex-col bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-md transition-shadow"
              >
                <div class="aspect-square overflow-hidden">
                  <img
                    src={p.imagen}
                    alt={textoAlternativo(p)}
                    width="400"
                    height="400"
                    class="w-full h-full object-contain p-4"
                    loading={i < EAGER_IMAGES ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "auto"}
                    decoding={i < EAGER_IMAGES ? "sync" : "async"}
                  />
                </div>
                <figcaption class="px-3 pb-3.5 pt-2.5 border-t border-gray-50">
                  {p.marca && (
                    <span class="block text-sm font-semibold text-[#2D6A4F] leading-snug">{p.marca}</span>
                  )}
                  <span class="block text-sm text-[#1C1C1C] leading-snug">{p.nombre}</span>
                  {p.presentacion && (
                    <span class="block text-xs text-gray-400 mt-1">{p.presentacion}</span>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Contenido propio de la categoría -->
    {contenido && (
      <section class="py-14 lg:py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl">
            {parrafos(contenido.intro).map(p => (
              <p class="text-lg text-gray-600 leading-relaxed mb-4">{p}</p>
            ))}

            {marcas.length > 0 && (
              <div class="mt-12">
                <h2 class="text-2xl sm:text-3xl font-bold text-[#1C1C1C] mb-4">
                  Marcas de {cat.name.toLowerCase()} sin gluten que distribuimos
                </h2>
                <p class="text-base text-gray-600 leading-relaxed mb-4">
                  {marcas.length === 1
                    ? `Por ahora trabajamos una sola marca en esta categoría, certificada por ANMAT`
                    : `Trabajamos ${marcas.length} marcas en esta categoría, todas certificadas por ANMAT`}
                  {' '}y con entrega directa en Mendoza, San Juan y San Luis.
                </p>
                <ul class="flex flex-wrap gap-2">
                  {marcas.map(m => (
                    <li class="text-sm font-medium text-[#2D6A4F] bg-[#2D6A4F]/10 px-4 py-2 rounded-full">{m}</li>
                  ))}
                </ul>
              </div>
            )}

            {contenido.presentaciones && (
              <div class="mt-12">
                <h2 class="text-2xl sm:text-3xl font-bold text-[#1C1C1C] mb-4">
                  Presentaciones, bultos y unidades por caja
                </h2>
                {parrafos(contenido.presentaciones).map(p => (
                  <p class="text-base text-gray-600 leading-relaxed mb-4">{p}</p>
                ))}
              </div>
            )}

            {contenido.minimoCompra && (
              <div class="mt-12">
                <h2 class="text-2xl sm:text-3xl font-bold text-[#1C1C1C] mb-4">
                  Mínimo de compra
                </h2>
                {parrafos(contenido.minimoCompra).map(p => (
                  <p class="text-base text-gray-600 leading-relaxed mb-4">{p}</p>
                ))}
              </div>
            )}

            {contenido.secciones.map(sec => (
              <div class="mt-12">
                <h2 class="text-2xl sm:text-3xl font-bold text-[#1C1C1C] mb-4">{sec.titulo}</h2>
                {parrafos(sec.cuerpo).map(p => (
                  <p class="text-base text-gray-600 leading-relaxed mb-4">{p}</p>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Info blocks -->
    <section class="py-14 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl">
          <div class="bg-[#FAFAF8] border border-gray-100 rounded-2xl p-6">
            <div class="text-3xl font-bold text-[#2D6A4F] mb-1">{cat.count}</div>
            <div class="text-sm text-gray-500">productos de {cat.name.toLowerCase()} sin gluten</div>
          </div>
          <div class="bg-[#FAFAF8] border border-gray-100 rounded-2xl p-6">
            <div class="text-3xl font-bold text-[#2D6A4F] mb-1">3</div>
            <div class="text-sm text-gray-500">provincias de cobertura directa</div>
          </div>
          <div class="bg-[#FAFAF8] border border-gray-100 rounded-2xl p-6">
            <div class="text-3xl font-bold text-[#2D6A4F] mb-1">10+</div>
            <div class="text-sm text-gray-500">años distribuyendo sin gluten</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Enlazado cruzado entre categorías -->
    <section class="py-14 lg:py-16 bg-[#FAFAF8] border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {relacionadas.length > 0 && (
          <>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#1C1C1C] mb-2">
              Otras categorías que se piden junto con {cat.name.toLowerCase()}
            </h2>
            <p class="text-base text-gray-500 mb-8 max-w-2xl">
              Los comercios que nos compran {cat.name.toLowerCase()} sin gluten suelen sumar
              estas categorías al mismo pedido.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
              {relacionadas.map(rel => (
                <a
                  href={`/categorias/${rel.slug}/`}
                  class="group flex items-center gap-4 bg-white border border-gray-100 hover:border-[#2D6A4F]/30 rounded-2xl p-4 transition-all hover:shadow-md"
                >
                  <img
                    src={rel.productos[0]?.imagen ?? rel.imageUrl}
                    alt={`${rel.name} sin gluten al por mayor`}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="w-16 h-16 shrink-0 rounded-xl object-contain bg-[#FAFAF8] p-1.5"
                  />
                  <span class="min-w-0">
                    <span class="block font-semibold text-[#1C1C1C] group-hover:text-[#2D6A4F] transition-colors">
                      {rel.name} sin gluten al por mayor
                    </span>
                    <span class="block text-sm text-gray-500">{rel.count} productos certificados</span>
                  </span>
                </a>
              ))}
            </div>
          </>
        )}

        <h2 class="text-lg font-semibold text-[#1C1C1C] mb-4">
          Todo el catálogo sin gluten al por mayor
        </h2>
        <ul class="flex flex-wrap gap-2">
          {restoDelCatalogo.map(otra => (
            <li>
              <a
                href={`/categorias/${otra.slug}/`}
                class="inline-block text-sm text-gray-600 hover:text-[#2D6A4F] bg-white border border-gray-100 hover:border-[#2D6A4F]/30 px-4 py-2 rounded-full transition-colors"
              >
                {otra.name} sin gluten al por mayor
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA final -->
    <section class="py-16 bg-[#2D6A4F]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          ¿Querés {cat.name.toLowerCase()} sin gluten para tu comercio?
        </h2>
        <p class="text-white/80 mb-8 max-w-xl mx-auto">
          Abastecemos dietéticas, almacenes, supermercados y gastronomía en Mendoza, San Juan y San Luis. Precios mayoristas con entrega directa.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1da851] text-white font-semibold px-8 py-4 rounded-full transition-all hover:scale-105 shadow-md"
          >
            Consultar por WhatsApp
          </a>
          <a
            href="/#categorias"
            class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-full transition-all border border-white/20"
          >
            ← Ver todas las categorías
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
